  editorDepositDate.on( 'preSubmit', function ( e, o, action ) 
  {
    if ( action !== 'remove' ) 
    {
      var recommendation = this.field( 'importApplication.recommendation' );
      var depositDate1 = this.field( 'offerFollowup.depositDate1' );
      var depositDate2 = this.field( 'offerFollowup.depositDate2' );

      // Only validate user input values
      if (!depositDate1.val() && 
           (recommendation.val() == 'F' || recommendation.val() == 'C' || recommendation.val() == 'CF'))
        depositDate1.error( 'A date must be given' );

      if (!depositDate2.val() && recommendation.val() == 'CF')
        depositDate2.error( 'A date must be given' );
        
      // If any error was reported, cancel the submission so it can be corrected
      if ( this.inError() ) 
      {
        return false;
      }
    }
  } );

